{
  "manifest_version": 3,
  "name": "LEXGUARD",
  "version": "0.2.0",
  "description": "See the risky sentence before you sign. Checks terms, offer letters and quotations inside your browser.",
  "permissions": ["activeTab", "scripting", "contextMenus", "sidePanel", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open LEXGUARD",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" }
}
